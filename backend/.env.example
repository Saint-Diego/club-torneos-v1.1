# --- Servidor ---
NODE_ENV=development
PORT=4000

# --- Base de datos (MongoDB Atlas o local) ---
MONGODB_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/club_torneos?retryWrites=true&w=majority

# --- Seguridad ---
# En producción: mínimo 32 caracteres aleatorios (openssl rand -base64 48)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
# Orígenes permitidos para CORS y WebSocket, separados por coma
CORS_ORIGIN=http://localhost:5173
# Cantidad de proxies inversos delante del backend (nginx = 1). 0 en desarrollo.
TRUST_PROXY=0
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# --- Negocio ---
APP_TIMEZONE=America/Bogota
AUDIT_RETENTION_DAYS=365
