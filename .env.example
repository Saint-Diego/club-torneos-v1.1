# ===== Variables para docker compose (copiar a .env y completar) =====

# --- Obligatorias ---
# MongoDB Atlas (producción). Ver docs/DEPLOYMENT.md para crear el clúster y el usuario.
MONGODB_URI=mongodb+srv://admin_user_01:adminsecret26@cluster0.yjlzr.mongodb.net/club_torneos?retryWrites=true&w=majority
# Mínimo 32 caracteres aleatorios:  openssl rand -base64 48
JWT_SECRET=8XDCnqGJ7oKEb49TjaFj3OS2xgiwO5B9uBQYhATASbO

# --- Acceso público ---
# URL(s) desde la que se sirve el frontend (CORS/WebSocket), separadas por coma.
CORS_ORIGIN=https://torneos.tu-club.com
HTTP_PORT=8080
# 127.0.0.1 si usas el perfil tls (Caddy). 0.0.0.0 para exponer nginx directamente.
FRONTEND_BIND=0.0.0.0
# Dominio para HTTPS automático (perfil tls).
DOMAIN=torneos.tu-club.com

# --- Ajustes (valores por defecto) ---
JWT_EXPIRES_IN=8h
APP_TIMEZONE=America/Bogota
AUDIT_RETENTION_DAYS=365
# Proxies inversos delante del backend: nginx = 1 (Caddy delante de nginx ya está resuelto por nginx).
TRUST_PROXY=1
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20

# --- Imágenes ---
# Local: club-torneos.  Con GHCR: ghcr.io/<owner>/<repo>  (en minúsculas)
IMAGE_PREFIX=club-torneos
IMAGE_TAG=latest

# --- Solo para crear el primer administrador (ver docs/DEPLOYMENT.md) ---
# ADMIN_EMAIL=admin@tu-club.com
# ADMIN_NAME=Administrador
# ADMIN_PASSWORD=
